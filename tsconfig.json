{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "types": ["node"] },
  "include": [
    "apps/main/**/*.ts",
    "apps/preload/**/*.ts",
    "apps/core/**/*.ts",
    "apps/desktop/*.ts",
    "apps/renderer/test/**/*.ts",
    "packages/**/*.ts",
    "tools/**/*.ts",
    "features/**/*.ts",
    "types/**/*.d.ts",
    "aliases.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "apps/desktop/out", "apps/desktop/.features-gen"]
}
